{
  "name": "hardbreak",
  "version": "0.0.0",
  "private": true,
  "description": "Enforced screen breaks for GNOME Shell: an undismissable full-screen overlay on every monitor.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.tooling.json && tsc --noEmit -p tsconfig.build.json && tsc -p tsconfig.shell-tests.json",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "validate": "bun run format && bun run check",
    "build": "bun run scripts/build.ts",
    "pack": "bun run scripts/pack.ts",
    "install:ext": "bun run scripts/install-ext.ts",
    "uninstall:ext": "bun run scripts/uninstall-ext.ts",
    "devkit": "bun run scripts/devkit.ts",
    "devkit:ctl": "bun run scripts/devkit-ctl.ts",
    "devkit:reset": "bun run scripts/devkit-reset.ts",
    "logs": "journalctl -f -o cat /usr/bin/gnome-shell",
    "prepare": "bun run scripts/install-hooks.ts"
  },
  "devDependencies": {
    "@girs/adw-1": "4.9.0",
    "@girs/ecal-2.0": "4.9.0",
    "@girs/edataserver-1.2": "4.9.0",
    "@girs/gjs": "4.9.0",
    "@girs/gnome-shell": "50.0.4",
    "@girs/gtk-4.0": "4.9.0",
    "@girs/icalglib-3.0": "4.9.0",
    "@types/bun": "1.4.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
